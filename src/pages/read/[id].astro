---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { documents } from "@/data/documents";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/pdf-reader.css";

export function getStaticPaths() {
  return documents.map(document => ({
    params: { id: document.id },
    props: { document },
  }));
}

const { document } = Astro.props;
const file = getAssetPath(document.file);
---

<Layout
  title={`${document.title} | ${config.site.title}`}
  description={`在线阅读${document.title}，支持目录、搜索、翻页和下载。`}
>
  <Header />
  <main
    id="main-content"
    class="pdf-reader"
    data-pdf-reader
    data-file={file}
    data-resources={getAssetPath("pdfjs/")}
  >
    <div class="reader-heading">
      <a class="reader-back" href={getAssetPath(document.article)}>← 返回文章</a
      >
      <div class="reader-title-row">
        <h1>{document.title}</h1>
        <a class="reader-button" href={file} download={`${document.title}.pdf`}
          >下载 PDF ↓</a
        >
      </div>
      <p class="reader-subtitle">PDF 文档 · 保留原始排版</p>
    </div>

    <div class="reader-toolbar" aria-label="阅读工具">
      <div class="reader-paging">
        <button
          class="reader-button"
          type="button"
          data-prev
          disabled
          aria-label="上一页">←</button
        >
        <form data-page-form>
          <label for="pdf-page">第</label>
          <input
            id="pdf-page"
            type="number"
            min="1"
            value="1"
            inputmode="numeric"
            disabled
          />
          <span> / <span data-page-count>—</span> 页</span>
          <button class="reader-button reader-go" type="submit" disabled
            >跳转</button
          >
        </form>
        <button
          class="reader-button"
          type="button"
          data-next
          disabled
          aria-label="下一页">→</button
        >
      </div>
      <label class="reader-zoom"
        >缩放
        <select data-zoom disabled aria-label="缩放比例">
          <option value="fit">适合宽度</option>
          <option value="0.75">75%</option>
          <option value="1">100%</option>
          <option value="1.25">125%</option>
          <option value="1.5">150%</option>
          <option value="2">200%</option>
        </select>
      </label>
    </div>

    <div class="reader-layout">
      <aside class="reader-sidebar" aria-label="文档导航">
        <details data-navigation open>
          <summary>目录与搜索</summary>
          <div class="reader-sidebar-body">
            <form data-search-form role="search">
              <label for="pdf-search">搜索文档</label>
              <div class="reader-search-row">
                <input
                  id="pdf-search"
                  type="search"
                  placeholder="输入关键词"
                  disabled
                />
                <button type="submit" class="reader-button" disabled
                  >搜索</button
                >
              </div>
            </form>
            <p class="reader-hint" data-search-status role="status"></p>
            <ol
              class="reader-results"
              data-search-results
              aria-label="搜索结果"
            >
            </ol>
            <h2>文档目录</h2>
            <p class="reader-hint" data-outline-status>正在读取目录…</p>
            <nav data-outline aria-label="PDF 目录"></nav>
          </div>
        </details>
      </aside>

      <section class="reader-content" aria-label="PDF 正文">
        <p class="reader-status" data-status role="status" aria-live="polite">
          正在加载文档…
        </p>
        <div class="reader-error" data-error role="alert" hidden>
          <p>暂时无法显示这份 PDF，请重试或打开原文件。</p>
          <button class="reader-button" type="button" data-retry
            >重新加载</button
          >
          <a class="reader-button" href={file} data-astro-reload>打开原 PDF</a>
        </div>
        <div
          class="reader-stage"
          data-stage
          aria-busy="true"
          tabindex="0"
          aria-label="PDF 页面，可用左右方向键翻页"
        >
          <div class="reader-paper" data-paper></div>
        </div>
        <noscript
          ><p>
            请启用 JavaScript 使用阅读器，或 <a href={file}>直接打开 PDF</a>。
          </p></noscript
        >
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/pdf-reader";
</script>
