(wingsluo-blog) {
    root * /var/www/wingsluo.com/current
    encode zstd gzip
    file_server

    @immutable path /_astro/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"

    handle_errors {
        @notFound expression {http.error.status_code} == 404
        handle @notFound {
            rewrite * /404.html
            file_server
        }
    }
}

wingsluo.com {
    import wingsluo-blog
}

# Temporary preview before the domain is switched to this server.
http://120.25.207.55 {
    import wingsluo-blog
}

# Private preview, reachable through SSH port forwarding only.
http://:4321 {
    bind 127.0.0.1
    root * /var/www/wingsluo.com/preview
    encode zstd gzip
    file_server
    header X-Robots-Tag "noindex, nofollow, noarchive"
    header X-Content-Type-Options "nosniff"
    handle_errors {
        @notFound expression {http.error.status_code} == 404
        handle @notFound {
            rewrite * /404.html
            file_server
        }
    }
}
